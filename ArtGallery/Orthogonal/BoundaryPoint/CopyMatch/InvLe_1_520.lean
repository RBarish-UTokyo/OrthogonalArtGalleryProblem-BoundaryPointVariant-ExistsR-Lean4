/-- The matched rays of the chamber test of channel 1. -/
theorem upper1 {args xs : List ℚ} (m : Model args xs rows boxes cache)
    (run : xs=execRat args [] (template.corridor.baseRows++template.corridor.rest)) :
    let s : ℝ := getRat args 0
    let J : ℝ := getRat args 1
    let Q : ℝ := getRat args 3
    let b : ℝ := ((((520:ℕ):ℝ)-1/5)/1001+5/2002*Q+40/1001*J*s : ℝ)
    let X := (grid template args false).map (fun q : ℚ => (q:ℝ))
    let Y := (grid template args true).map (fun q : ℚ => (q:ℝ))
    Y.getD 22 0≠1-50050/s^2 → Y.getD 21 0≠Y.getD 1 0 → ∀ t : ℝ,
      lineX (s/320+b*(50050/s^2)+t,1-50050/s^2) (X.getD 12 0,Y.getD 22 0) (Y.getD 25 0)=
        lineX (X.getD 55 0+2/3*(X.getD 56 0-X.getD 55 0)*t,Y.getD 1 0) (X.getD 15 0,Y.getD 21 0) (Y.getD 25 0) := by
  intro s J Q b X Y hB hR t
  have Xdef : X=(grid template args false).map (fun q : ℚ => (q:ℝ)) := rfl
  have Ydef : Y=(grid template args true).map (fun q : ℚ => (q:ℝ)) := rfl
  have hs : (0:ℝ)<s := by simp only [s]; exact_mod_cast m.pos
  have hin : ∀ k P d, (k,P,d)∈c1ins → ((getRat args k : ℚ) : ℝ)*d=Ex.ev s b J P := by
    intro k P d hk
    simp only [c1ins,List.mem_cons,List.not_mem_nil,or_false,Prod.mk.injEq] at hk
    rcases hk with ⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩ <;>
      simp [Ex.ev,ev3,ev2,ev1,b] <;> ring
  have H := RegCert.check_sound m.run m.bounds hin c1cert [] (by simp) c1ok
  have lBx : Lift s b J (s/320+b*(50050/s^2)) c1L c1BxN c1BxD c1BxC :=
    ⟨by simp [c1BxN,c1BxD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c1Bxcof⟩
  have lBy : Lift s b J (1-50050/s^2) c1L c1ByN c1ByD c1ByC :=
    ⟨by simp [c1ByN,c1ByD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c1Bycof⟩
  have lcBx : Lift s b J (X.getD 12 0) c1L c1cBxN c1cBxD c1cBxC :=
    ⟨by
      have hr := H c1r369 (List.mem_append_right _ (by simp [c1tops]))
      have e : X.getD 12 0=((getRat xs 369 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 12]; rfl
      rw [e]; exact hr.1,c1cBxcof⟩
  have lcBy : Lift s b J (Y.getD 22 0) c1L c1cByN c1cByD c1cByC :=
    ⟨by
      have hr := H c1r285 (List.mem_append_right _ (by simp [c1tops]))
      have e : Y.getD 22 0=((getRat xs 285 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 22]; rfl
      rw [e]; exact hr.1,c1cBycof⟩
  have la : Lift s b J (Y.getD 25 0) c1L c1aN c1aD c1aC :=
    ⟨by
      have hr := H c1r364 (List.mem_append_right _ (by simp [c1tops]))
      have e : Y.getD 25 0=((getRat xs 364 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 25]; rfl
      rw [e]; exact hr.1,c1acof⟩
  have lRx : Lift s b J (X.getD 55 0) c1L c1RxN c1RxD c1RxC :=
    ⟨by
      have e : X.getD 55 0=((((axisOf template false).coordsQ (getRat args 0)).getD 12 0 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 55]; rfl
      rw [e,level_cast,level_eq _ _ _ (by decide)]
      simp [axisOf,template,RoomFamily.InvLe.xAxis,Gap.valR,evalR,c1RxN,c1RxD,Ex.ev,ev3,ev2,ev1]
      ring,c1Rxcof⟩
  have lRy : Lift s b J (Y.getD 1 0) c1L c1RyN c1RyD c1RyC :=
    ⟨by
      have e : Y.getD 1 0=((((axisOf template true).coordsQ (getRat args 0)).getD 1 0 : ℚ) : ℝ) := by
