        rw [Xdef,grid_ref m run false 33]; rfl
      rw [e]; exact hr.1,c1cRxcof⟩
  have lcRy : Lift s b J (Y.getD 49 0) c1L c1cRyN c1cRyD c1cRyC :=
    ⟨by
