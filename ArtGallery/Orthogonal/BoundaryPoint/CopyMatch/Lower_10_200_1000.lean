/-- The matched rays of the chamber test of channel 2. -/
theorem upper2 {args xs : List ℚ} (m : Model args xs rows boxes cache)
    (run : xs=execRat args [] (template.corridor.baseRows++template.corridor.rest)) :
    let s : ℝ := getRat args 0
    let J : ℝ := getRat args 1
    let Q : ℝ := getRat args 4
    let b : ℝ := ((((1000:ℕ):ℝ)-1/5)/1001+5/2002*Q+40/1001*J*s : ℝ)
    let X := (grid template args false).map (fun q : ℚ => (q:ℝ))
    let Y := (grid template args true).map (fun q : ℚ => (q:ℝ))
    Y.getD 32 0≠1-50050/s^2 → Y.getD 31 0≠Y.getD 2 0 → ∀ t : ℝ,
      lineX (s/320+b*(50050/s^2)+t,1-50050/s^2) (X.getD 17 0,Y.getD 32 0) (Y.getD 35 0)=
        lineX (X.getD 71 0+2/3*(X.getD 72 0-X.getD 71 0)*t,Y.getD 2 0) (X.getD 20 0,Y.getD 31 0) (Y.getD 35 0) := by
  intro s J Q b X Y hB hR t
  have Xdef : X=(grid template args false).map (fun q : ℚ => (q:ℝ)) := rfl
  have Ydef : Y=(grid template args true).map (fun q : ℚ => (q:ℝ)) := rfl
  have hs : (0:ℝ)<s := by simp only [s]; exact_mod_cast m.pos
  have hin : ∀ k P d, (k,P,d)∈c2ins → ((getRat args k : ℚ) : ℝ)*d=Ex.ev s b J P := by
    intro k P d hk
    simp only [c2ins,List.mem_cons,List.not_mem_nil,or_false,Prod.mk.injEq] at hk
    rcases hk with ⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩ <;>
      simp [Ex.ev,ev3,ev2,ev1,b] <;> ring
  have H := RegCert.check_sound m.run m.bounds hin c2cert [] (by simp) c2ok
  have lBx : Lift s b J (s/320+b*(50050/s^2)) c2L c2BxN c2BxD c2BxC :=
    ⟨by simp [c2BxN,c2BxD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c2Bxcof⟩
  have lBy : Lift s b J (1-50050/s^2) c2L c2ByN c2ByD c2ByC :=
    ⟨by simp [c2ByN,c2ByD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c2Bycof⟩
  have lcBx : Lift s b J (X.getD 17 0) c2L c2cBxN c2cBxD c2cBxC :=
    ⟨by
      have hr := H c2r526 (List.mem_append_right _ (by simp [c2tops]))
      have e : X.getD 17 0=((getRat xs 526 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 17]; rfl
      rw [e]; exact hr.1,c2cBxcof⟩
  have lcBy : Lift s b J (Y.getD 32 0) c2L c2cByN c2cByD c2cByC :=
    ⟨by
      have hr := H c2r395 (List.mem_append_right _ (by simp [c2tops]))
      have e : Y.getD 32 0=((getRat xs 395 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 32]; rfl
      rw [e]; exact hr.1,c2cBycof⟩
  have la : Lift s b J (Y.getD 35 0) c2L c2aN c2aD c2aC :=
    ⟨by
      have hr := H c2r521 (List.mem_append_right _ (by simp [c2tops]))
      have e : Y.getD 35 0=((getRat xs 521 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 35]; rfl
      rw [e]; exact hr.1,c2acof⟩
  have lRx : Lift s b J (X.getD 71 0) c2L c2RxN c2RxD c2RxC :=
    ⟨by
      have e : X.getD 71 0=((((axisOf template false).coordsQ (getRat args 0)).getD 10 0 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 71]; rfl
      rw [e,level_cast,level_eq _ _ _ (by decide)]
      simp [axisOf,template,RoomFamily.Lower.xAxis,Gap.valR,evalR,c2RxN,c2RxD,Ex.ev,ev3,ev2,ev1]
      ring,c2Rxcof⟩
  have lRy : Lift s b J (Y.getD 2 0) c2L c2RyN c2RyD c2RyC :=
    ⟨by
      have e : Y.getD 2 0=((((axisOf template true).coordsQ (getRat args 0)).getD 2 0 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 2]; rfl
      rw [e,level_cast,level_eq _ _ _ (by decide)]
      simp [axisOf,template,RoomFamily.Lower.yAxis,Gap.valR,evalR,c2RyN,c2RyD,Ex.ev,ev3,ev2,ev1]
      ring,c2Rycof⟩
  have lcRx : Lift s b J (X.getD 20 0) c2L c2cRxN c2cRxD c2cRxC :=
    ⟨by
      have hr := H c2r393 (List.mem_append_right _ (by simp [c2tops]))
      have e : X.getD 20 0=((getRat xs 393 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 20]; rfl
      rw [e]; exact hr.1,c2cRxcof⟩
  have lcRy : Lift s b J (Y.getD 31 0) c2L c2cRyN c2cRyD c2cRyC :=
    ⟨by
      have hr := H c2r524 (List.mem_append_right _ (by simp [c2tops]))
      have e : Y.getD 31 0=((getRat xs 524 : ℚ) : ℝ) := by
        rw [Ydef,grid_ref m run true 31]; rfl
      rw [e]; exact hr.1,c2cRycof⟩
  have lSx : Lift s b J (X.getD 72 0) c2L c2SxN c2SxD c2SxC :=
    ⟨by
      have e : X.getD 72 0=((((axisOf template false).coordsQ (getRat args 0)).getD 11 0 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 72]; rfl
      rw [e,level_cast,level_eq _ _ _ (by decide)]
      simp [axisOf,template,RoomFamily.Lower.xAxis,Gap.valR,evalR,c2SxN,c2SxD,Ex.ev,ev3,ev2,ev1]
      ring,c2Sxcof⟩
  have hL : Ex.ev s b J c2L≠0 := by
    have k := RegCert.auto_sound c2Lne s b J
