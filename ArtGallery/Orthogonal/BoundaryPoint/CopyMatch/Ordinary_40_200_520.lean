    intro h0; rw [h0,zero_mul,zero_sub,neg_eq_zero] at k
    exact (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (H c0r964 (List.mem_append_right _ (by simp [c0tops]))).2 (H c0r967 (List.mem_append_right _ (by simp [c0tops]))).2) (H c0r506 (List.mem_append_right _ (by simp [c0tops]))).2) (H c0r455 (List.mem_append_right _ (by simp [c0tops]))).2) (H c0r969 (List.mem_append_right _ (by simp [c0tops]))).2) (by simp [c0BxD,Ex.ev,ev3,ev2,ev1]; positivity)) k
  exact matched hL lBx lBy lcBx lcBy la lRx lRy lcRx lcRy lSx c0k0 c0k1 hB hR t


