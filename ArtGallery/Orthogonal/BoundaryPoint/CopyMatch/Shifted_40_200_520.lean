  have hL : Ex.ev s b J c1L≠0 := by
    have k := RegCert.auto_sound c1Lne s b J
    simp only [Ex.ev] at k
    intro h0; rw [h0,zero_mul,zero_sub,neg_eq_zero] at k
    exact (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (H c1r744 (List.mem_append_right _ (by simp [c1tops]))).2 (H c1r747 (List.mem_append_right _ (by simp [c1tops]))).2) (H c1r493 (List.mem_append_right _ (by simp [c1tops]))).2) (H c1r424 (List.mem_append_right _ (by simp [c1tops]))).2) (H c1r749 (List.mem_append_right _ (by simp [c1tops]))).2) (by simp [c1BxD,Ex.ev,ev3,ev2,ev1]; positivity)) k
  exact matched hL lBx lBy lcBx lcBy la lRx lRy lcRx lcRy lSx c1k0 c1k1 hB hR t


