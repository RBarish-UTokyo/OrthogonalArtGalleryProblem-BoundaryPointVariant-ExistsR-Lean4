  have lRx : Lift s b J (X.getD 67 0) c1L c1RxN c1RxD c1RxC :=
    ⟨by
      have e : X.getD 67 0=((((axisOf template false).coordsQ (getRat args 0)).getD 6 0 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 67]; rfl
