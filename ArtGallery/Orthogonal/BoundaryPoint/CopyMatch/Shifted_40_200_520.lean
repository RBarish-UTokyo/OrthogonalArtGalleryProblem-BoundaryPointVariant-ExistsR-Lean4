/-- The matched rays of the chamber test of channel 0. -/
theorem upper0 {args xs : List ℚ} (m : Model args xs rows boxes cache)
    (run : xs=execRat args [] (template.corridor.baseRows++template.corridor.rest)) :
    let s : ℝ := getRat args 0
    let J : ℝ := getRat args 1
    let Q : ℝ := getRat args 2
    let b : ℝ := ((((40:ℕ):ℝ)-1/5)/1001+5/2002*Q+40/1001*J*s : ℝ)
    let X := (grid template args false).map (fun q : ℚ => (q:ℝ))
    let Y := (grid template args true).map (fun q : ℚ => (q:ℝ))
    Y.getD 68 0≠1-50050/s^2 → Y.getD 67 0≠Y.getD 6 0 → ∀ t : ℝ,
      lineX (s/320+b*(50050/s^2)+t,1-50050/s^2) (X.getD 43 0,Y.getD 68 0) (Y.getD 71 0)=
        lineX (X.getD 63 0+2/3*(X.getD 64 0-X.getD 63 0)*t,Y.getD 6 0) (X.getD 46 0,Y.getD 67 0) (Y.getD 71 0) := by
  intro s J Q b X Y hB hR t
  have Xdef : X=(grid template args false).map (fun q : ℚ => (q:ℝ)) := rfl
  have Ydef : Y=(grid template args true).map (fun q : ℚ => (q:ℝ)) := rfl
  have hs : (0:ℝ)<s := by simp only [s]; exact_mod_cast m.pos
  have hin : ∀ k P d, (k,P,d)∈c0ins → ((getRat args k : ℚ) : ℝ)*d=Ex.ev s b J P := by
    intro k P d hk
    simp only [c0ins,List.mem_cons,List.not_mem_nil,or_false,Prod.mk.injEq] at hk
    rcases hk with ⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩|⟨rfl,rfl,rfl⟩ <;>
      simp [Ex.ev,ev3,ev2,ev1,b] <;> ring
  have H := RegCert.check_sound m.run m.bounds hin c0cert [] (by simp) c0ok
  have lBx : Lift s b J (s/320+b*(50050/s^2)) c0L c0BxN c0BxD c0BxC :=
    ⟨by simp [c0BxN,c0BxD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c0Bxcof⟩
  have lBy : Lift s b J (1-50050/s^2) c0L c0ByN c0ByD c0ByC :=
    ⟨by simp [c0ByN,c0ByD,Ex.ev,ev3,ev2,ev1]; field_simp; ring,c0Bycof⟩
  have lcBx : Lift s b J (X.getD 43 0) c0L c0cBxN c0cBxD c0cBxC :=
    ⟨by
      have hr := H c0r969 (List.mem_append_right _ (by simp [c0tops]))
      have e : X.getD 43 0=((getRat xs 969 : ℚ) : ℝ) := by
        rw [Xdef,grid_ref m run false 43]; rfl
      rw [e]; exact hr.1,c0cBxcof⟩
  have lcBy : Lift s b J (Y.getD 68 0) c0L c0cByN c0cByD c0cByC :=
    ⟨by
      have hr := H c0r506 (List.mem_append_right _ (by simp [c0tops]))
      have e : Y.getD 68 0=((getRat xs 506 : ℚ) : ℝ) := by
