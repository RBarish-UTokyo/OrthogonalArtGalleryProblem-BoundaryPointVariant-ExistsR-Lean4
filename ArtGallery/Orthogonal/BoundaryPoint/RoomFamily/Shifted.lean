theorem guards_and_witnesses_on_boundary (n : Nat) (hn : 65 ≤ n) :
    let p := gridPt (xAxis.coordsR (1/(n:ℝ))) (yAxis.coordsR (1/(n:ℝ)))
    ∀ r ∈ GridPins.requirements roles, segment (p r.1) (p r.2) ⊆ (room n).boundary := by
